[Icon Theme]
Name=RR-Oscuro-Iconos
Comment=RR ALIADOS: Wi-Fi y Bluetooth para panel negro (#070001). Colores fijos.
Inherits=Papirus-Dark,Papirus,Yaru-magenta-dark,Yaru-dark,Yaru,Adwaita,hicolor
Directories=scalable/status,scalable/places,scalable/devices,symbolic/status,symbolic/places,symbolic/devices
Example=nm-signal-100

[scalable/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[scalable/places]
Context=Places
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/status]
Context=Status
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/places]
Context=Places
Size=16
MinSize=8
MaxSize=512
Type=Scalable

[symbolic/devices]
Context=Devices
Size=16
MinSize=8
MaxSize=512
Type=Scalable
